# ---------------------------------------------------------------
# ProofLens configuration. Copy to .env and adjust.
# All paths are relative to the project root unless absolute.
# ---------------------------------------------------------------

# HTTP
PORT=4000
# Allowed browser origin for CORS in development (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Storage
DB_PATH=database/prooflens.db
STORAGE_DIR=storage

# Ed25519 signing key (PEM, PKCS#8). Generated by `npm run keys`.
# DEVELOPMENT ONLY: in production keep the private key in a KMS/HSM
# and never on the application server's disk.
SIGNING_KEY_PATH=storage/keys/signing-ed25519.pem

# TrustMark watermark models (ONNX, ~63 MB). Downloaded by `npm run models`.
MODEL_PATH=storage/models
# Set to false to run without watermarking (e.g. low-memory machines)
WATERMARK_ENABLED=true

# C2PA development certificate chain (generated by `npm run c2pa-certs`)
C2PA_ENABLED=true
C2PA_CERT_DIR=storage/c2pa

# Upload limits
MAX_UPLOAD_MB=15
MAX_INPUT_PIXELS=40000000

# Rate limiting (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
